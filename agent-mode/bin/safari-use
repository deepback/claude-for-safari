#!/usr/bin/env node
'use strict';
// safari-use: drive Safari like Claude in Chrome does. Own window + tabs, ref-based DOM tree, cursor/glow/Stop overlay.
const fs = require('fs'), os = require('os'), path = require('path'), crypto = require('crypto');
const { spawnSync } = require('child_process');

const ROOT = path.resolve(__dirname, '..');
const HOME = path.join(os.homedir(), '.cache', 'safari-use');
const STATE = path.join(HOME, 'state.json');
fs.mkdirSync(path.join(HOME, 'shots'), { recursive: true });

const RT_SRC = fs.readFileSync(path.join(ROOT, 'lib', 'runtime.js'), 'utf8');
const RT_VER = crypto.createHash('sha1').update(RT_SRC).digest('hex').slice(0, 10);
const RUNTIME = RT_SRC.replace('var V = "2.0.0";', 'var V = "' + RT_VER + '";');

const sleep = ms => Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, ms);
const out = s => process.stdout.write(s + '\n');
class Fail extends Error { constructor(m, code) { super(m); this.code = code || 1; } }

/* ------------------------------------------------------------------ state */
function load() { try { return JSON.parse(fs.readFileSync(STATE, 'utf8')); } catch (e) { return {}; } }
function save(s) { fs.writeFileSync(STATE, JSON.stringify(s, null, 1)); }

/* ---------------------------------------------------------------- osascript */
function osaError(msg) {
  msg = String(msg);
  if (/Allow JavaScript from Apple Events/i.test(msg)) return new Fail('Safari blocks page JavaScript from scripts. Enable it once: Safari > Settings > Advanced > "Show features for web developers", then menu Develop > Developer Settings > "Allow JavaScript from Apple Events". Then retry.', 4);
  if (/-1743|not authorized|Not authorized|не разрешено|Нет разрешения/i.test(msg)) return new Fail('macOS Automation permission missing: System Settings > Privacy & Security > Automation: allow this terminal/app to control Safari.', 4);
  if (/Упрощенного доступа|assistive access|-25211/i.test(msg)) return new Fail('macOS Accessibility permission missing: System Settings > Privacy & Security > Accessibility: allow this terminal/app (needed for group and --native).', 4);
  if (/-1728|Invalid index|Can.t get (window|tab)/i.test(msg)) return new Fail('Agent window/tab is gone (closed by the user?). Run: safari-use start', 5);
  if (/-1712|timed out|истекло/i.test(msg)) return new Fail('Safari did not answer in time (a native dialog may be open, or the page is busy).', 6);
  return new Fail(msg.trim());
}
function osa(lines, args, timeout) {
  const r = spawnSync('osascript', [].concat(...lines.map(l => ['-e', l])).concat(args || []), { encoding: 'utf8', maxBuffer: 128 << 20, timeout: timeout || 100000 });
  if (r.status !== 0) throw osaError(r.stderr || (r.error && r.error.message) || 'osascript failed');
  return (r.stdout || '').replace(/\n$/, '');
}
const JS_LINES = ['on run argv', 'set w to (item 1 of argv) as integer', 'set t to (item 2 of argv) as integer',
  'tell application "Safari"', 'with timeout of 90 seconds', 'return do JavaScript (item 3 of argv) in tab t of window id w',
  'end timeout', 'end tell', 'end run'];
function doJS(win, tab, src) { return osa(JS_LINES, [String(win), String(tab), src]); }

function windowIds() {
  const o = osa(['tell application "Safari"', 'set o to ""', 'repeat with w in windows', 'set o to o & (id of w) & ","', 'end repeat', 'return o', 'end tell']);
  return o.split(',').filter(Boolean).map(Number);
}
function tabCount(win) {
  try { return +osa(['tell application "Safari" to return count of tabs of window id ' + (win | 0)]); } catch (e) { return 0; }
}
function frontAppName() {
  const r = spawnSync('sh', ['-c', 'lsappinfo info -only name "$(lsappinfo front)"'], { encoding: 'utf8' });
  const m = /"LSDisplayName"="([^"]+)"/.exec(r.stdout || ''); return m ? m[1] : null;
}
function restoreFront(name) { if (name && name !== 'Safari') spawnSync('open', ['-a', name]); }

function agentWin() {
  const st = load();
  if (!st.win) throw new Fail('No agent window yet. Run: safari-use start [url]', 5);
  if (!tabCount(st.win)) { throw new Fail('Agent window is gone. Run: safari-use start [url]', 5); }
  return st;
}

/* -------------------------------------------------------------- page calls */
function parseOut(o) {
  if (o === 'missing value' || o === '') throw new Fail('Page returned nothing (page still loading or a native dialog is open).');
  try { return JSON.parse(o); } catch (e) { throw new Fail('Bad page response: ' + String(o).slice(0, 200)); }
}
function page(tab, name, args) {
  const st = agentWin();
  const n = JSON.stringify(name), a = JSON.stringify(args || {});
  const fast = '(function(){var s=window.__csf;return(s&&s.v==="' + RT_VER + '")?JSON.stringify(s.call(' + n + ',' + a + ')):"__NEED_RT__"})()';
  let o = doJS(st.win, tab, fast);
  if (o === '__NEED_RT__') o = doJS(st.win, tab, RUNTIME + '\n;JSON.stringify(window.__csf.call(' + n + ',' + a + '))');
  const r = parseOut(o);
  if (r && r.stopped) throw new Fail('STOPPED: the user pressed "Stop Claude". Do nothing further and ask the user how to continue (then run: safari-use resume).', 3);
  if (r && r.error) throw new Fail(r.error + (r.message ? ': ' + r.message : ''));
  return r;
}
function pageRetry(tab, name, args, tries) {
  let last;
  for (let i = 0; i < (tries || 6); i++) { try { return page(tab, name, args); } catch (e) { if (e.code === 3 || e.code === 4 || e.code === 5) throw e; last = e; sleep(350); } }
  throw last;
}
function rawJS(tab, src) { const st = agentWin(); return doJS(st.win, tab, src); }

function waitLoaded(tab, prevUrl, target, timeoutMs) {
  const t0 = Date.now(); sleep(250);
  while (Date.now() - t0 < (timeoutMs || 25000)) {
    let r = null;
    try { r = JSON.parse(rawJS(tab, 'JSON.stringify({u:location.href,r:document.readyState})')); } catch (e) { if (e.code === 4 || e.code === 5) throw e; sleep(300); continue; }
    const moved = r.u !== prevUrl && (r.u !== 'about:blank' || target === 'about:blank');
    if (r.r === 'complete' && (moved || Date.now() - t0 > 1500)) return r;
    sleep(300);
  }
  return { timeout: true };
}

/* ----------------------------------------------------------------- helpers */
function parseArgs(argv) {
  const flags = {}, pos = [];
  const VAL = new Set(['tab', 'filter', 'depth', 'ref', 'max', 'out', 'pattern', 'limit', 'text', 'gone', 'selector', 'name', 'ticks', 'timeout', 'label']);
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a.startsWith('--')) { const k = a.slice(2); if (VAL.has(k)) flags[k] = argv[++i]; else flags[k] = true; }
    else pos.push(a);
  }
  return { flags, pos };
}
function targetArg(s) {
  if (/^ref_\d+$/.test(s || '')) return { ref: s };
  const m = /^(\d+)\s*[, ]\s*(\d+)$/.exec(s || '');
  if (m) return { x: +m[1], y: +m[2] };
  throw new Fail('Target must be a ref (ref_12 from read/find) or coordinates "x,y", got: ' + s);
}
const curTab = f => (f.tab ? +f.tab : (load().tab || 1));
function mods(f) { return { ctrl: !!f.ctrl, shift: !!f.shift, alt: !!f.alt, meta: !!(f.cmd || f.meta) }; }

function listTabs() {
  const st = agentWin();
  const o = osa(['tell application "Safari"', 'set o to ""', 'set tb to character id 9', 'tell window id ' + (st.win | 0), 'repeat with i from 1 to (count of tabs)',
    'set u to URL of tab i', 'if u is missing value then set u to ""', 'set n to name of tab i', 'if n is missing value then set n to ""',
    'set o to o & i & tb & n & tb & u & linefeed', 'end repeat', 'end tell', 'return o', 'end tell']);
  return o.split('\n').filter(Boolean).map(l => { const p = l.split('\t'); return { i: +p[0], title: (p[1] || '').replace(/^🟠 /, ''), url: p[2] || '' }; });
}
function printTabs() {
  const st = load(), tabs = listTabs();
  out('Claude tab group (Safari window ' + st.win + ')');
  tabs.forEach(t => out((t.i === (st.tab || 1) ? '* ' : '  ') + 'tab ' + t.i + ' | ' + (t.title || '(untitled)') + ' | ' + (t.url || 'about:blank')));
}

/* snapshot / recording */
function helper(name) {
  const src = path.join(ROOT, 'scripts', name + '.swift'), bin = path.join(HOME, 'bin', name);
  fs.mkdirSync(path.dirname(bin), { recursive: true });
  if (!fs.existsSync(bin) || fs.statSync(bin).mtimeMs < fs.statSync(src).mtimeMs) {
    const env = Object.assign({}, process.env, { CLANG_MODULE_CACHE_PATH: path.join(HOME, 'mod'), SWIFT_MODULE_CACHE_PATH: path.join(HOME, 'mod') });
    const r = spawnSync('swiftc', [src, '-o', bin], { encoding: 'utf8', env });
    if (r.status !== 0) throw new Fail('swiftc failed (install Xcode Command Line Tools): ' + (r.stderr || '').slice(0, 300));
  }
  return bin;
}
function winBounds(win) {
  const o = osa(['tell application "Safari" to return bounds of window id ' + (win | 0)]);
  const b = o.split(/,\s*/).map(Number); return { l: b[0], t: b[1], r: b[2], b: b[3] };
}
function snap(tab, outFile, full) {
  const st = agentWin(); const info = page(tab, 'ping', { quiet: true });
  const b = winBounds(st.win);
  const list = (spawnSync(helper('safari_wid'), ['--all'], { encoding: 'utf8' }).stdout || '').split('\n').filter(Boolean).map(l => l.split('\t'));
  let cg = list.find(p => +p[0] === st.win);
  if (!cg) cg = list.find(p => { const q = p[1].split(',').map(Number); return q[0] === b.l && q[1] === b.t && q[2] === b.r - b.l && q[3] === b.b - b.t; });
  if (!cg) throw new Fail('Agent window is not on screen (minimized?). Un-minimize it; screenshots need it visible and Screen Recording permission.');
  const r = spawnSync('screencapture', ['-l', cg[0], '-o', '-x', outFile], { encoding: 'utf8' });
  if (r.status !== 0 || !fs.existsSync(outFile) || fs.statSync(outFile).size < 500) throw new Fail('screencapture failed. Grant Screen Recording to this terminal/app: System Settings > Privacy & Security > Screen Recording.');
  if (!full) {
    const g = k => +(/:\s*(\d+)/.exec(spawnSync('sips', ['-g', k, outFile], { encoding: 'utf8' }).stdout.split('\n').find(l => l.includes(k)) || '')[1]);
    const pw = g('pixelWidth'), sc = pw / (b.r - b.l), winH = b.b - b.t, winW = b.r - b.l;
    const top = Math.round((winH - info.vh) * sc), left = Math.round((winW - info.vw) * sc);
    if (top > 0 && top < g('pixelHeight')) spawnSync('sips', ['-c', String(Math.round(info.vh * sc)), String(Math.round(info.vw * sc)), '--cropOffset', String(top), String(left), outFile], { encoding: 'utf8' });
  }
  return outFile;
}
function afterAction(tab) {
  const s = load();
  if (s.rec) { try { snap(tab, path.join(s.rec, String(s.recN = (s.recN || 0) + 1).padStart(4, '0') + '.png'), false); save(s); } catch (e) { /* recording is best-effort */ } }
}
function settle(tab, before) {
  let info = null;
  for (let i = 0; i < 5; i++) {
    sleep(i === 0 ? 380 : 400);
    try { info = pageRetry(tab, 'ping', { quiet: true }, 3); } catch (e) { if (e.code === 3) throw e; info = null; }
    if (info && (info.url !== before || info.ready === 'loading')) break;
    if (!info) continue; // page is mid-navigation
  }
  if (info && (info.url !== before || info.ready === 'loading')) {
    const w = waitLoaded(tab, before); info = pageRetry(tab, 'ping', {}); out('Navigated to ' + info.url + ' | "' + info.title + '"' + (w.timeout ? ' (still loading)' : ''));
  }
  afterAction(tab);
}

/* ---------------------------------------------------------------- commands */
const C = {};

C.doctor = () => {
  out('safari-use doctor');
  try { out('ok  Automation: Safari reachable, ' + windowIds().length + ' window(s)'); } catch (e) { out('FAIL Automation: ' + e.message); return; }
  const st = load();
  try {
    if (st.win && tabCount(st.win)) { out('ok  Page JS: ' + doJS(st.win, st.tab || 1, 'String(1+1)')); }
    else {
      const ids = windowIds(); if (!ids.length) { out('--  Page JS: no window to test; run "safari-use start" first'); }
      else out('ok  Page JS: ' + doJS(ids[0], 1, 'String(1+1)'));
    }
  } catch (e) { out('FAIL Page JS: ' + e.message); }
  try { helper('safari_wid'); out('ok  Swift helper compiled'); } catch (e) { out('FAIL Swift helper: ' + e.message); }
  out('--  Screen Recording (screenshots) and Accessibility (--native clicks, group) are checked on first use.');
};

C.start = ({ pos, flags }) => {
  const st = load();
  if (st.win && tabCount(st.win)) { out('Agent window already open.'); printTabs(); return; }
  const url = pos[0] || 'about:blank', before = windowIds(), prev = frontAppName();
  osa(['on run argv', 'tell application "Safari"', 'make new document with properties {URL:(item 1 of argv)}', 'end tell', 'end run'], [url]);
  let win = null;
  for (let i = 0; i < 40 && !win; i++) {
    const fresh = windowIds().filter(id => before.indexOf(id) < 0);
    for (const id of fresh) if (tabCount(id) > 0) win = id;
    if (!win) sleep(150);
  }
  if (!win) throw new Fail('Safari did not open a new window.');
  restoreFront(prev);
  save({ win, tab: 1 });
  try {
    if (url !== 'about:blank') waitLoaded(1, 'about:blank', url);
    pageRetry(1, 'ping', { label: flags.label });
  } catch (e) { if (e.code === 4) { out('Window opened, but: ' + e.message); printTabs(); return; } throw e; }
  out('Opened Claude tab group in a separate Safari window (your own tabs are untouched).');
  printTabs();
  if (flags.group) C.group({ pos: ['Claude'], flags: {} });
};

C.end = () => {
  const st = load(); if (!st.win) return out('Nothing to close.');
  try { osa(['tell application "Safari" to close window id ' + (st.win | 0)]); } catch (e) { /* already gone */ }
  save({}); out('Closed the agent window.');
};

C.tabs = () => { printTabs(); try { const i = page(curTab({}), 'info', {}); out('current: ' + i.url + ' | scroll ' + i.scrollY + '/' + i.scrollMax + ' | viewport ' + i.vw + 'x' + i.vh + (i.stopped ? ' | STOPPED by user' : '')); } catch (e) { if (e.code === 3) out('STOPPED by user'); } };

C.tab = ({ pos, flags }) => {
  const st = agentWin(), sub = pos[0];
  if (sub === 'new') {
    const url = pos[1] || 'about:blank';
    osa(['on run argv', 'tell application "Safari"', 'tell window id ' + (st.win | 0), 'set nt to make new tab with properties {URL:(item 1 of argv)}', 'end tell', 'end tell', 'end run'], [url]);
    const n = tabCount(st.win); st.tab = n; save(st);
    if (url !== 'about:blank') waitLoaded(n, 'about:blank', url);
    pageRetry(n, 'ping', {}); printTabs();
  } else if (sub === 'select') {
    const n = +pos[1]; if (!n || n > tabCount(st.win)) throw new Fail('No such tab. Use: safari-use tabs');
    osa(['tell application "Safari" to set current tab of window id ' + (st.win | 0) + ' to tab ' + (n | 0) + ' of window id ' + (st.win | 0)]);
    st.tab = n; save(st); try { pageRetry(n, 'ping', {}, 2); } catch (e) { /* blank tab */ } printTabs();
  } else if (sub === 'close') {
    const n = +(pos[1] || curTab(flags)), cnt = tabCount(st.win);
    if (cnt <= 1) throw new Fail('Cannot close the last tab; use "safari-use end" to close the window.');
    osa(['tell application "Safari" to close tab ' + (n | 0) + ' of window id ' + (st.win | 0)]);
    st.tab = Math.min(st.tab || 1, cnt - 1); save(st); printTabs();
  } else throw new Fail('usage: tab new [url] | tab select N | tab close [N]');
};

C.goto = ({ pos, flags }) => {
  let url = pos[0]; if (!url) throw new Fail('usage: goto <url>');
  if (!/^[a-z][a-z0-9+.-]*:/i.test(url)) url = 'https://' + url;
  const st = agentWin(), tab = curTab(flags);
  let prev = ''; try { prev = JSON.parse(rawJS(tab, 'JSON.stringify(location.href)')); } catch (e) { /* blank */ }
  osa(['on run argv', 'tell application "Safari" to set URL of tab ' + (tab | 0) + ' of window id ' + (st.win | 0) + ' to (item 1 of argv)', 'end run'], [url]);
  const w = waitLoaded(tab, prev, url), i = pageRetry(tab, 'ping', {});
  out('Loaded ' + i.url + ' | "' + i.title + '"' + (w.timeout ? ' (still loading)' : '')); afterAction(tab);
};
['back', 'forward', 'reload'].forEach(k => C[k] = ({ flags }) => {
  const tab = curTab(flags); page(tab, 'ping', {}); const prev = JSON.parse(rawJS(tab, 'JSON.stringify(location.href)'));
  rawJS(tab, k === 'reload' ? 'location.reload();"ok"' : 'history.' + k + '();"ok"');
  waitLoaded(tab, prev); const i = pageRetry(tab, 'ping', {}); out(k + ': ' + i.url + ' | "' + i.title + '"'); afterAction(tab);
});

C.read = ({ flags }) => {
  const r = page(curTab(flags), 'read', { filter: flags.filter || 'all', viewport: !!flags.viewport, depth: flags.depth && +flags.depth, ref: flags.ref, max: flags.max && +flags.max, quiet: !!flags.quiet });
  out(r.text || '(empty)'); out('\n[' + r.count + ' nodes' + (r.truncated ? ', TRUNCATED: use --filter interactive, --viewport or --ref' : '') + ' | viewport ' + r.viewport + ' | scroll ' + r.scrollY + '/' + r.scrollMax + ']');
};
C.find = ({ pos, flags }) => { const r = page(curTab(flags), 'find', { query: pos.join(' '), limit: flags.limit && +flags.limit }); out(r.count ? r.text + '\n[' + r.count + ' match(es)]' : 'No matches. Try other words or run read.'); };
C.text = ({ flags }) => out(page(curTab(flags), 'text', { maxChars: flags.max && +flags.max }).text);

function clickLike(opts) {
  return ({ pos, flags }) => {
    const tab = curTab(flags), t = targetArg(pos[0]);
    const before = JSON.parse(rawJS(tab, 'JSON.stringify(location.href)'));
    const prep = page(tab, 'prepare', t);
    if (prep.disabled) out('warning: target is disabled');
    sleep(flags.fast ? 60 : 520);
    let res;
    if (flags.native) {
      const st = agentWin(), i = page(tab, 'ping', { quiet: true }), b = winBounds(st.win);
      const p = page(tab, 'prepare', t);
      const sx = b.l + ((b.r - b.l) - i.vw) + p.x, sy = b.t + ((b.b - b.t) - i.vh) + p.y;
      osa(['tell application "Safari"', 'set index of window id ' + (st.win | 0) + ' to 1', 'activate', 'end tell']); sleep(300);
      const r = spawnSync(helper('mouse'), [String(sx), String(sy), opts.right ? 'right' : 'left', String(opts.count || 1)], { encoding: 'utf8' });
      if (r.status !== 0) throw new Fail('native click failed (grant Accessibility to this terminal/app): ' + (r.stderr || ''));
      res = { clicked: p.target + ' (native)', x: p.x, y: p.y, obscuredBy: p.obscuredBy };
    } else res = page(tab, 'click', Object.assign({}, t, { right: opts.right, count: opts.count, mods: mods(flags) }));
    out((opts.hover ? 'Hovered ' : 'Clicked ') + res.clicked + ' at (' + res.x + ',' + res.y + ')' + (res.obscuredBy ? '\nwarning: point is covered by ' + res.obscuredBy + '; the click may not do what you expect' : ''));
    settle(tab, before);
  };
}
C.click = clickLike({}); C.dblclick = clickLike({ count: 2 }); C.tripleclick = clickLike({ count: 3 }); C.rclick = clickLike({ right: true });
C.hover = ({ pos, flags }) => { const tab = curTab(flags), t = targetArg(pos[0]); page(tab, 'prepare', t); sleep(450); out('Hovered ' + page(tab, 'hover', t).hovered); afterAction(tab); };
C.drag = ({ pos, flags }) => { const tab = curTab(flags); page(tab, 'prepare', targetArg(pos[0])); sleep(450); const r = page(tab, 'drag', { from: targetArg(pos[0]), to: targetArg(pos[1]) }); out('Dragged ' + r.dragged + ' to ' + r.to); settle(tab, JSON.parse(rawJS(tab, 'JSON.stringify(location.href)'))); };

C.type = ({ pos, flags }) => {
  const tab = curTab(flags), t = targetArg(pos[0]); if (pos.length < 2) throw new Fail('usage: type <ref> "text" [--clear]');
  page(tab, 'prepare', t); sleep(450);
  const r = page(tab, 'type', { ref: t.ref, text: pos.slice(1).join(' '), clear: !!flags.clear });
  out('Typed ' + r.typed + ' chars into ' + r.into + (r.value ? ' -> value "' + r.value + '"' : '')); afterAction(tab);
};
C.fill = ({ pos, flags }) => {
  const tab = curTab(flags), t = targetArg(pos[0]); let v = pos.slice(1).join(' ');
  if (v === 'true') v = true; else if (v === 'false') v = false;
  page(tab, 'prepare', t); sleep(450);
  out('Filled: ' + JSON.stringify(page(tab, 'fill', { ref: t.ref, value: v }))); afterAction(tab);
};
C.key = ({ pos, flags }) => {
  const tab = curTab(flags), before = JSON.parse(rawJS(tab, 'JSON.stringify(location.href)'));
  pos.forEach(k => { const r = page(tab, 'key', { combo: k, ref: flags.ref }); out('Pressed ' + r.pressed + ' on ' + r.on); sleep(120); });
  settle(tab, before);
};
C.scroll = ({ pos, flags }) => {
  const tab = curTab(flags), dir = pos[0] || 'down', ticks = +(pos[1] || flags.ticks || 3);
  const r = page(tab, 'scroll', { dir, ticks, ref: flags.ref }); out('Scrolled ' + dir + ' -> scrollY ' + r.scrollY + '/' + r.max); afterAction(tab);
};
C.scrollto = ({ pos, flags }) => { const r = page(curTab(flags), 'scrollto', { ref: targetArg(pos[0]).ref }); out('Scrolled to ' + r.at + ' -> scrollY ' + r.scrollY); afterAction(curTab(flags)); };

C.wait = ({ pos, flags }) => {
  const tab = curTab(flags), tmo = (+flags.timeout || 30) * 1000, t0 = Date.now();
  if (!flags.text && !flags.gone && !flags.selector) { sleep(Math.min(60, +pos[0] || 1) * 1000); out('Waited ' + (pos[0] || 1) + 's'); return; }
  const q = JSON.stringify(flags.text || flags.gone || flags.selector);
  const expr = flags.selector ? '!!document.querySelector(' + q + ')' : '(document.body&&document.body.innerText||"").indexOf(' + q + ')>-1';
  while (Date.now() - t0 < tmo) {
    let v = false; try { v = JSON.parse(rawJS(tab, 'JSON.stringify(' + expr + ')')); } catch (e) { /* loading */ }
    if (flags.gone ? !v : v) { out('Condition met after ' + ((Date.now() - t0) / 1000).toFixed(1) + 's'); return; }
    sleep(500);
  }
  throw new Fail('Timed out waiting.');
};

C.shot = ({ flags }) => {
  const tab = curTab(flags), f = flags.out || path.join(HOME, 'shots', 'shot-' + Date.now() + '.png');
  page(tab, 'ping', {}); sleep(150); snap(tab, f, !!flags.full); out(f);
};
C.console = ({ flags }) => { const r = page(curTab(flags), 'console', { errorsOnly: !!flags.errors, pattern: flags.pattern, limit: flags.limit && +flags.limit, quiet: true }); out(r.count ? r.text : '(no console messages since the helper was injected)'); };
C.net = ({ flags }) => { const r = page(curTab(flags), 'net', { pattern: flags.pattern, limit: flags.limit && +flags.limit, quiet: true }); out(r.count ? r.text : '(no fetch/XHR since the helper was injected)'); };
C.js = ({ pos, flags }) => {
  const code = pos.join(' '), tab = curTab(flags); page(tab, 'ping', { quiet: true });
  out(rawJS(tab, flags.body ? 'JSON.stringify((function(){' + code + '})())' : 'JSON.stringify((' + code + '))'));
};
C.resize = ({ pos }) => {
  const m = /^(\d+)x(\d+)$/.exec(pos[0] || ''); if (!m) throw new Fail('usage: resize WIDTHxHEIGHT (window size, points)');
  const st = agentWin(), b = winBounds(st.win);
  osa(['tell application "Safari" to set bounds of window id ' + (st.win | 0) + ' to {' + [b.l, b.t, b.l + +m[1], b.t + +m[2]].join(', ') + '}']); out('Window resized to ' + m[1] + 'x' + m[2]);
};
C.release = () => { const n = tabCount(agentWin().win); for (let i = 1; i <= n; i++) { try { rawJS(i, '(function(){var s=window.__csf;if(s)s.call("release",{});return 1})()'); } catch (e) { /* ignore */ } } out('Overlay hidden.'); };
C.resume = ({ flags }) => { page(curTab(flags), 'resume', {}); out('Resumed.'); };

C.record = ({ pos }) => {
  const s = load();
  if (pos[0] === 'start') { const d = path.join(HOME, 'rec-' + Date.now()); fs.mkdirSync(d); s.rec = d; s.recN = 0; save(s); out('Recording: a frame is saved after every action.'); }
  else if (pos[0] === 'stop') {
    if (!s.rec) throw new Fail('Not recording.');
    if (!fs.readdirSync(s.rec).some(n => n.endsWith('.png'))) { delete s.rec; save(s); throw new Fail('No frames were captured. Screenshots need Screen Recording permission for this app (System Settings > Privacy & Security > Screen Recording).'); }
    const f = pos[1] || path.join(HOME, 'shots', 'record-' + Date.now() + '.gif');
    const r = spawnSync('ffmpeg', ['-y', '-framerate', '1.5', '-i', path.join(s.rec, '%04d.png'), '-vf', 'scale=900:-1:flags=lanczos,split[a][b];[a]palettegen[p];[b][p]paletteuse', f], { encoding: 'utf8' });
    delete s.rec; save(s); if (r.status !== 0) throw new Fail('ffmpeg failed: ' + (r.stderr || '').slice(-200)); out(f);
  } else throw new Fail('usage: record start | record stop [out.gif]');
};

C.group = ({ pos }) => {
  const st = agentWin(), nm = pos[0] || 'Claude';
  out('EXPERIMENTAL: creating a native Safari Tab Group via menu automation (needs Accessibility; brings Safari to the front).');
  // Prefer "New Tab Group with This Tab/N Tabs" (moves the agent tabs in), fall back to "New Empty Tab Group". EN + RU menus.
  const res = osa(['on run argv', 'set nm to item 1 of argv',
    'tell application "Safari"', 'set index of window id ' + (st.win | 0) + ' to 1', 'activate', 'end tell', 'delay 0.5',
    'tell application "System Events"', 'tell process "Safari"', 'set frontmost to true', 'set fm to missing value',
    'repeat with mi in menu bar items of menu bar 1', 'if (name of mi) is in {"File", "\u0424\u0430\u0439\u043b"} then set fm to mi', 'end repeat',
    'if fm is missing value then error "File menu not found"',
    'set pats to {"Tab Group with", "\u0433\u0440\u0443\u043f\u043f\u0430 \u0432\u043a\u043b\u0430\u0434\u043e\u043a \u0441 ", "Empty Tab Group", "\u0433\u0440\u0443\u043f\u043f\u0430 \u043f\u0443\u0441\u0442\u044b\u0445 \u0432\u043a\u043b\u0430\u0434\u043e\u043a"}',
    'set done to ""', 'repeat with p in pats', 'repeat with mItem in menu items of menu 1 of fm', 'set n to name of mItem',
    'if n is not missing value then', 'if n contains (contents of p) and (enabled of mItem) then', 'click mItem', 'set done to n', 'exit repeat', 'end if', 'end if', 'end repeat',
    'if done is not "" then exit repeat', 'end repeat',
    'if done is "" then error "No New Tab Group menu item found"', 'delay 1.0', 'set named to "no"', 'set f to value of attribute "AXFocusedUIElement"', 'set fv to ""', 'try', 'set fv to value of f', 'end try', 'if (frontmost) and (role of f) is "AXTextField" and (fv is in {"\u0411\u0435\u0437 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u044f", "Untitled"}) then', 'set value of f to nm', 'key code 36', 'set named to "yes"', 'end if', 'return done & " | named=" & named',
    'end tell', 'end tell', 'end run'], [nm]);
  out('Used menu item: ' + res + (/named=no/.test(res) ? '\nGroup created but not renamed (focus was not on its name field; rename it in the sidebar yourself).' : '\nTab group "' + nm + '" created.'));
};

C.help = () => out(fs.readFileSync(path.join(ROOT, 'SKILL.md'), 'utf8').split('\n## Commands')[1] ? 'See SKILL.md' : 'See SKILL.md');

/* -------------------------------------------------------------------- main */
const [cmd, ...rest] = process.argv.slice(2);
if (!cmd || !C[cmd]) { console.error('usage: safari-use <' + Object.keys(C).join('|') + '> [args]\nSee ' + path.join(ROOT, 'SKILL.md')); process.exit(cmd ? 2 : 0); }
try { C[cmd](parseArgs(rest)); }
catch (e) { console.error((e instanceof Fail ? '' : 'internal error: ') + (e.message || e)); if (!(e instanceof Fail)) console.error(e.stack); process.exit(e.code || 1); }
